# Remembrancer web app — environment template
# Copy to .env and fill in values to enable Firebase Auth, Firestore, and Firebase AI Logic.
# Leaving these as placeholders keeps the app in guest/local mode.

# Firebase Web app configuration (Console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_PROJECT_ID=PROJECT_ID
VITE_FIREBASE_AUTH_DOMAIN=PROJECT_ID.firebaseapp.com
VITE_FIREBASE_APP_ID=1:PROJECT_NUMBER:web:YOUR_APP_ID
VITE_FIREBASE_STORAGE_BUCKET=PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=PROJECT_NUMBER
VITE_FIREBASE_MEASUREMENT_ID=

# App Check production provider (reCAPTCHA v3). Required when the debug switch is off.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

# Local/evaluation only: set localStorage "remembrancer.appcheck-debug" to "1" in DevTools,
# then register this token in Firebase Console → App Check → your Web app → Manage debug tokens.
# Never commit a real debug token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
